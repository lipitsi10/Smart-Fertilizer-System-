  if (moisturePercent < 40) {
    tft.setTextColor(RED);
  } else {
    tft.setTextColor(DARK_GREEN);
  }
  tft.setTextSize(2);
  tft.setCursor(18, 197);
  tft.print(fertilizerNeeded);

  drawFooter();
}

void drawCropCard(int x, int y, String crop) {
  tft.fillRoundRect(x, y, 185, 36, 7, WHITE);
  tft.drawRoundRect(x, y, 185, 36, 7, CARD_BORDER);
  tft.fillCircle(x + 14, y + 18, 5, GREEN);
  tft.setTextColor(DARK_TEXT);
  tft.setTextSize(1);
  tft.setCursor(x + 27, y + 14);
  tft.print(crop);
}

void drawPumpDisplay() {
  drawCard(204, 50, 108, 172);
  tft.setTextColor(GREY_TEXT);
  tft.setTextSize(1);
  tft.setCursor(236, 61);
  tft.print("PUMP");

  if (pumpState) {
    tft.fillCircle(258, 110, 31, GREEN);
    tft.setTextColor(WHITE);
    tft.setTextSize(2);
    tft.setCursor(235, 155);
    tft.print("ON");
    tft.setTextSize(1);
    tft.setCursor(219, 180);
    tft.print("FERTILIZING");
  } else {
    tft.fillCircle(258, 110, 31, RED);
    tft.setTextColor(WHITE);
    tft.setTextSize(2);
    tft.setCursor(232, 155);
    tft.print("OFF");
    tft.setTextSize(1);
    tft.setCursor(220, 180);
    tft.print("STANDBY");
  }
}

void drawPage2() {
  tft.fillScreen(BG_COLOR);
  drawHeader();

  drawCard(8, 50, 188, 172);
  tft.setTextSize(1);
  tft.setTextColor(GREY_TEXT);
  tft.setCursor(18, 61);
  tft.print("CROP RECOMMENDATION");

  if (crop1 != "") drawCropCard(15, 75, crop1);
  if (crop2 != "") drawCropCard(15, 118, crop2);
  if (crop3 != "") drawCropCard(15, 161, crop3);

  drawPumpDisplay();
  drawFooter();
}

void drawStartup() {
  tft.fillScreen(BG_COLOR);
  tft.fillRect(0, 0, 320, 8, HEADER_GREEN);
  tft.setTextColor(DARK_TEXT);
  tft.setTextSize(3);
  tft.setCursor(54, 65);
  tft.print("SMART");
  tft.setCursor(40, 100);
  tft.print("FERTILIZER");
  tft.setTextSize(1);
  tft.setTextColor(DARK_GREEN);
  tft.setCursor(91, 142);
  tft.print("SYSTEM");
  tft.setTextColor(GREY_TEXT);
  tft.setCursor(92, 164);
  tft.print("FEED THE SOIL");
  tft.setCursor(92, 179);
  tft.print("FEED THE FUTURE");
  tft.setTextColor(DARK_TEXT);
  tft.setCursor(72, 210);
  tft.print("SEABI TECH INNOVATIONS");
  delay(2500);
}

// ==================== SETUP ====================
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println();
  Serial.println("================================");
  Serial.println("SMART FERTILIZER SYSTEM");
  Serial.println("SEABI TECH INNOVATIONS");
  Serial.println("MQTT MODE");
  Serial.println("================================");

  MQTT_TELEMETRY_TOPIC = "smartfertilizer/" + String(DEVICE_ID) + "/telemetry";
  MQTT_COMMAND_TOPIC   = "smartfertilizer/" + String(DEVICE_ID) + "/command";
  MQTT_STATUS_TOPIC    = "smartfertilizer/" + String(DEVICE_ID) + "/status";

  pinMode(SOIL_PIN, INPUT);
  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);
  dht.begin();

  SPI.begin(TFT_SCK, TFT_MISO, TFT_MOSI);

  tft.begin();
  tft.setRotation(1);
  tft.setSPISpeed(20000000);

  tft.fillScreen(BG_COLOR);
  delay(300);

  drawStartup();
  readSensors();
  automaticPumpControl();

  currentPage = 1;
  pageStartTime = millis();
  drawPage1();

  // ---- Wi-Fi connection ----
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.print("Connecting to Wi-Fi");

  unsigned long wifiStart = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - wifiStart < 15000) {
    delay(500);
    Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println();
    Serial.print("Connected, IP address: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println();
    Serial.println("Wi-Fi connection timed out – continuing without network.");
  }

  tft.begin();
  tft.setRotation(1);
  tft.setSPISpeed(20000000);
  if (currentPage == 1) drawPage1();
  else drawPage2();

  delay(500);

  esp_wifi_set_ps(WIFI_PS_NONE);

  if (WiFi.status() == WL_CONNECTED) {
    mqttConnected = mqttConnect();
    if (mqttConnected) {
      publishTelemetry(); // announce we're online, same spirit as the old startup Telegram message
    }
  }

  Serial.println("SYSTEM READY");
}

// ==================== LOOP ====================
void loop() {
  if (millis() - sensorTimer >= SENSOR_INTERVAL) {
    sensorTimer = millis();
    readSensors();
    automaticPumpControl();

    if (currentPage == 1) drawPage1();
    else drawPage2();
  }

  if (millis() - pageStartTime >= PAGE_TIME) {
    pageStartTime = millis();
    if (currentPage == 1) {
      currentPage = 2;
      drawPage2();
    } else {
      currentPage = 1;
      drawPage1();
    }
  }

  // ---- MQTT: reconnect if needed, then service incoming commands ----
  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttConnected && millis() - lastMqttAttempt >= MQTT_RETRY_INTERVAL) {
      lastMqttAttempt = millis();
      mqttConnected = mqttConnect();
    }
    mqttLoop();

    if (mqttConnected && millis() - lastStatusSent >= STATUS_INTERVAL) {
      lastStatusSent = millis();
      publishTelemetry();
    }
  }
}

