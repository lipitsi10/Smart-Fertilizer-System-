// ---- Fertilizer recommendation (expanded) ----
String fertilizerNeeded  = "NOT NEEDED"; // short label, kept for TFT display
String fertilizerRatio   = "NOT NEEDED"; // e.g. "NPK 15:15:15"
String fertilizerUrgency = "NONE";       // CRITICAL / HIGH / MODERATE / LOW / NONE
String fertilizerRate    = "0g per m2";  // application rate guidance
int nitrogenPct   = 0;
int phosphorusPct = 0;
int potassiumPct  = 0;
String fertilizerNotes = "";

// ==================== CROP DATABASE ====================
// Each crop also carries its own ideal NPK blend, since the "one blend fits
// the whole field" recommendation above is a fallback — once we know which
// crop is being grown, its own ratio is more useful.
struct Crop {
  const char* name;
  int minMoisture;
  int maxMoisture;
  const char* idealFertilizer;
};

Crop crops[] = {
  {"Maize",     50, 70, "NPK 20:10:10 (nitrogen-rich, vegetative growth)"},
  {"Potatoes",  60, 75, "NPK 15:15:30 (potassium-rich, tuber development)"},
  {"Tomatoes",  60, 80, "NPK 10:20:20 (phosphorus & potassium, fruiting)"},
  {"Spinach",   50, 80, "NPK 25:10:10 (nitrogen-rich, leafy growth)"},
  {"Onions",    60, 80, "NPK 15:20:15 (balanced, bulb formation)"},
  {"Cabbage",   60, 80, "NPK 20:15:15 (nitrogen-phosphorus, head formation)"},
  {"Macadamia", 50, 70, "NPK 10:15:25 (potassium-rich, tree/nut crop)"}
};

const int numberOfCrops = sizeof(crops) / sizeof(crops[0]);

String crop1 = "";
String crop2 = "";
String crop3 = "";
String crop1Fertilizer = "";
String crop2Fertilizer = "";
String crop3Fertilizer = "";

// ==================== SOIL MOISTURE ====================
int getMoisture(int rawValue) {
  rawValue = constrain(rawValue, SOIL_WET_VALUE, SOIL_DRY_VALUE);
  int percentage = map(rawValue, SOIL_DRY_VALUE, SOIL_WET_VALUE, 0, 100);
  return constrain(percentage, 0, 100);
}

// ==================== SOIL CONDITION ====================
void updateSoilCondition() {
  if (moisturePercent >= SOIL_FERTILIZER_LIMIT)
    soilCondition = "GOOD";
  else
    soilCondition = "BAD";
}

// ==================== FERTILIZER RECOMMENDATION (expanded) ====================
// Five moisture bands instead of three, each with: a general NPK ratio, an
// urgency level, an application-rate guideline, an approximate N-P-K percent
// breakdown, and a short agronomic note. This is the "whole field" fallback
// recommendation shown when no specific crop is selected — the per-crop
// ratios in the Crop table above take precedence once a crop is known.
void updateFertilizer() {
  if (moisturePercent < 20) {
    fertilizerRatio   = "NPK 10:10:10";
    fertilizerUrgency = "CRITICAL";
    fertilizerRate    = "200g per m2";
    nitrogenPct = 10; phosphorusPct = 10; potassiumPct = 10;
    fertilizerNotes   = "Severe moisture deficit — irrigate before or alongside fertilizing to avoid root burn.";
  } else if (moisturePercent < 40) {
    fertilizerRatio   = "NPK 15:15:15";
    fertilizerUrgency = "HIGH";
    fertilizerRate    = "150g per m2";
    nitrogenPct = 15; phosphorusPct = 15; potassiumPct = 15;
    fertilizerNotes   = "Soil is dry — balanced feed recommended to support root uptake.";
  } else if (moisturePercent < 60) {
    fertilizerRatio   = "NPK 20:20:20";
    fertilizerUrgency = "MODERATE";
    fertilizerRate    = "100g per m2";
    nitrogenPct = 20; phosphorusPct = 20; potassiumPct = 20;
    fertilizerNotes   = "Moisture approaching adequate — standard balanced feeding.";
  } else if (moisturePercent < 80) {
    fertilizerRatio   = "NPK 5:5:5 (maintenance)";
    fertilizerUrgency = "LOW";
    fertilizerRate    = "50g per m2";
    nitrogenPct = 5; phosphorusPct = 5; potassiumPct = 5;
    fertilizerNotes   = "Soil condition good — light maintenance feed only.";
  } else {
    fertilizerRatio   = "NOT NEEDED";
    fertilizerUrgency = "NONE";
    fertilizerRate    = "0g per m2";
    nitrogenPct = 0; phosphorusPct = 0; potassiumPct = 0;
    fertilizerNotes   = "Soil is saturated — withhold fertilizer to avoid nutrient runoff/leaching.";
  }

  fertilizerNeeded = fertilizerRatio; // short label used by the TFT display
}

// ==================== CROP RECOMMENDATION ====================
void findCropRecommendations() {
  crop1 = ""; crop1Fertilizer = "";
  crop2 = ""; crop2Fertilizer = "";
  crop3 = ""; crop3Fertilizer = "";
  int found = 0;

  for (int i = 0; i < numberOfCrops; i++) {
    if (moisturePercent >= crops[i].minMoisture && moisturePercent <= crops[i].maxMoisture) {
      if (found == 0) { crop1 = crops[i].name; crop1Fertilizer = crops[i].idealFertilizer; }
      else if (found == 1) { crop2 = crops[i].name; crop2Fertilizer = crops[i].idealFertilizer; }
      else if (found == 2) { crop3 = crops[i].name; crop3Fertilizer = crops[i].idealFertilizer; }
      found++;
      if (found >= 3) break;
    }
  }

  if (found == 0) {
    // Fallback picks by name — look up each one's ideal fertilizer from the table
    const char* fallbackNames[3];
    if (moisturePercent < 40) {
      fallbackNames[0] = "Maize"; fallbackNames[1] = "Onions"; fallbackNames[2] = "Macadamia";
    } else {
      fallbackNames[0] = "Tomatoes"; fallbackNames[1] = "Cabbage"; fallbackNames[2] = "Spinach";
    }
    String* names[3] = {&crop1, &crop2, &crop3};
    String* ferts[3] = {&crop1Fertilizer, &crop2Fertilizer, &crop3Fertilizer};
    for (int slot = 0; slot < 3; slot++) {
      *names[slot] = fallbackNames[slot];
      for (int i = 0; i < numberOfCrops; i++) {
        if (String(crops[i].name) == fallbackNames[slot]) {
          *ferts[slot] = crops[i].idealFertilizer;
          break;
        }
      }
    }
  }
}

// ==================== READ ALL SENSORS ====================
void readSensors() {
  int rawSoil = analogRead(SOIL_PIN);
  moisturePercent = getMoisture(rawSoil);
  updateSoilCondition();

  float newHumidity = dht.readHumidity();
  float newTemperature = dht.readTemperature();

  if (!isnan(newHumidity)) humidity = newHumidity;
  if (!isnan(newTemperature)) temperature = newTemperature;

  updateFertilizer();
  findCropRecommendations();

  Serial.print("Soil Moisture: ");
  Serial.print(moisturePercent);
  Serial.print("% | Soil Condition: ");
  Serial.print(soilCondition);
  Serial.print(" | Temperature: ");
  Serial.print(temperature);
  Serial.print(" C | Humidity: ");
  Serial.print(humidity);
  Serial.println("%");
}

// ==================== START/STOP PUMP ====================
void startPump() {
  if (pumpState) return;
  pumpState = true;
  digitalWrite(PUMP_PIN, HIGH);
  pumpStartTime = millis();
  Serial.println("PUMP ON");
}

void stopPump() {
  if (!pumpState) return;
  pumpState = false;
  digitalWrite(PUMP_PIN, LOW);
  Serial.println("PUMP OFF");
}

void automaticPumpControl() {
  if (manualPumpControl) return;

  if (moisturePercent >= SOIL_FERTILIZER_LIMIT) {
    stopPump();
  } else {
    startPump();
  }
}

// ============================================================================
// MQTT — hand-rolled MQTT 3.1.1, same variable-length-encoding fix as the
// livestock tracker firmware. Kept as ONE PERSISTENT connection (not
// connect/publish/disconnect per message) because this device also needs to
// receive commands, not just send telemetry.
// ============================================================================

void writeMqttRemainingLength(WiFiClient &client, int length) {
  do {
    uint8_t encodedByte = length % 128;
    length = length / 128;
    if (length > 0) {
      encodedByte |= 0x80;
    }
    client.write(encodedByte);
  } while (length > 0);
}

// Reads a variable-length "remaining length" field from an incoming packet.
// Returns -1 if the bytes aren't available yet (caller should back off and
// retry later rather than blocking).
int readMqttRemainingLength(WiFiClient &client) {
  int multiplier = 1;
  int value = 0;
  uint8_t encodedByte;
  int guard = 0;
  do {
    unsigned long start = millis();
    while (!client.available()) {
      if (millis() - start > 1000) return -1; // timeout waiting for next byte
    }
    encodedByte = client.read();
    value += (encodedByte & 0x7F) * multiplier;
    multiplier *= 128;
    guard++;
  } while ((encodedByte & 0x80) != 0 && guard < 4);
  return value;
}

void mqttSendConnect() {
  String clientId = "esp32_" + String(DEVICE_ID) + "_" + String(random(1000, 9999));
  uint8_t varHeader[] = { 0x00, 0x04, 'M', 'Q', 'T', 'T', 0x04, 0x02, 0x00, 0x3C }; // clean session, 60s keepalive
  int clientLen = clientId.length();
  int remLen = sizeof(varHeader) + 2 + clientLen;

  mqttClient.write((uint8_t)0x10); // CONNECT
  writeMqttRemainingLength(mqttClient, remLen);
  mqttClient.write(varHeader, sizeof(varHeader));
  mqttClient.write((uint8_t)(clientLen >> 8));
  mqttClient.write((uint8_t)(clientLen & 0xFF));
  mqttClient.print(clientId);
}

void mqttSendSubscribe(const String &topic) {
  int topicLen = topic.length();
  uint16_t packetId = 1;
  // variable header (packet id) + topic length prefix + topic + QoS byte
  int remLen = 2 + 2 + topicLen + 1;

  mqttClient.write((uint8_t)0x82); // SUBSCRIBE (flags 0x2 required by spec)
  writeMqttRemainingLength(mqttClient, remLen);
  mqttClient.write((uint8_t)(packetId >> 8));
  mqttClient.write((uint8_t)(packetId & 0xFF));
  mqttClient.write((uint8_t)(topicLen >> 8));
  mqttClient.write((uint8_t)(topicLen & 0xFF));
  mqttClient.print(topic);
  mqttClient.write((uint8_t)0x00); // QoS 0
}

bool mqttConnect() {
  Serial.println("[MQTT] Connecting to broker...");
  if (!mqttClient.connect(MQTT_BROKER, MQTT_PORT)) {
    Serial.println("[MQTT] TCP connection failed.");
    return false;
  }

  mqttSendConnect();

  unsigned long start = millis();
  bool acked = false;
  while (millis() - start < 2000) {
    if (mqttClient.available() >= 4) {
      uint8_t ack[4];
      mqttClient.read(ack, 4);
      if (ack[0] == 0x20 && ack[3] == 0x00) acked = true;
      break;
    }
    delay(10);
  }

  if (!acked) {
    Serial.println("[MQTT] CONNACK not received / rejected.");
    mqttClient.stop();
    return false;
  }

  mqttSendSubscribe(MQTT_COMMAND_TOPIC);

  // Drain the SUBACK (4 bytes: fixed header, remaining length, packet id x2, return code)
  start = millis();
  while (millis() - start < 1500 && mqttClient.available() < 5) delay(10);
  while (mqttClient.available()) mqttClient.read(); // discard SUBACK bytes

  Serial.println("[MQTT] Connected and subscribed to " + MQTT_COMMAND_TOPIC);
  lastPingSent = millis();
  return true;
}

void mqttPublish(const String &topic, const String &payload) {
  if (!mqttConnected) return;

  int topicLen = topic.length();
  int msgLen = payload.length();
  int remLen = 2 + topicLen + msgLen;

  mqttClient.write((uint8_t)0x30); // PUBLISH, QoS 0
  writeMqttRemainingLength(mqttClient, remLen);
  mqttClient.write((uint8_t)(topicLen >> 8));
  mqttClient.write((uint8_t)(topicLen & 0xFF));
  mqttClient.print(topic);
  mqttClient.print(payload);
}

// Builds one crop-recommendation JSON object, or an empty string if that
// slot wasn't filled (so the array only contains real matches).
String buildCropJson(const String &name, const String &fert) {
  if (name == "") return "";
  return "{\"name\":\"" + name + "\",\"ideal_fertilizer\":\"" + fert + "\"}";
}

// Full telemetry payload — every sensor reading, the whole-field fertilizer
// recommendation (ratio, urgency, application rate, N-P-K breakdown, notes),
// and the matched crop recommendations each with their own ideal blend.
void publishTelemetry() {
  String cropsJson = "[";
  bool firstCrop = true;
  String c1 = buildCropJson(crop1, crop1Fertilizer);
  String c2 = buildCropJson(crop2, crop2Fertilizer);
  String c3 = buildCropJson(crop3, crop3Fertilizer);
  if (c1 != "") { cropsJson += c1; firstCrop = false; }
  if (c2 != "") { cropsJson += (firstCrop ? "" : ",") + c2; firstCrop = false; }
  if (c3 != "") { cropsJson += (firstCrop ? "" : ",") + c3; }
  cropsJson += "]";

  String json = "{";
  json += "\"device_id\":\"" + String(DEVICE_ID) + "\",";
  json += "\"uptime_ms\":" + String(millis()) + ",";
  json += "\"soil_moisture\":" + String(moisturePercent) + ",";
  json += "\"soil_condition\":\"" + soilCondition + "\",";
  json += "\"temperature\":" + String(temperature, 1) + ",";
  json += "\"humidity\":" + String(humidity, 1) + ",";
  json += "\"fertilizer\":{";
  json +=   "\"ratio\":\"" + fertilizerRatio + "\",";
  json +=   "\"urgency\":\"" + fertilizerUrgency + "\",";
  json +=   "\"application_rate\":\"" + fertilizerRate + "\",";
  json +=   "\"nitrogen_pct\":" + String(nitrogenPct) + ",";
  json +=   "\"phosphorus_pct\":" + String(phosphorusPct) + ",";
  json +=   "\"potassium_pct\":" + String(potassiumPct) + ",";
  json +=   "\"notes\":\"" + fertilizerNotes + "\"";
  json += "},";
  json += "\"crop_recommendations\":" + cropsJson + ",";
  json += "\"pump_state\":" + String(pumpState ? "true" : "false") + ",";
  json += "\"mode\":\"" + String(manualPumpControl ? "manual" : "automatic") + "\"";
  json += "}";

  mqttPublish(MQTT_TELEMETRY_TOPIC, json);
  Serial.println("[MQTT] Telemetry published (" + String(json.length()) + " bytes).");
}

void publishStatus() {
  // Same payload shape as telemetry — kept as a separate topic so the PWA
  // can request/display "last known status" independent of the rolling feed.
  publishTelemetry();
}

// Handles ONE incoming command payload (mirrors the Telegram command set).
void handleCommand(const String &payload) {
  String cmd = payload;
  cmd.trim();
  cmd.toLowerCase();

  Serial.println("[MQTT] Command received: " + cmd);

  if (cmd == "pump_on") {
    startPump();
    manualPumpControl = true;
  } else if (cmd == "pump_off") {
    stopPump();
    manualPumpControl = true;
  } else if (cmd == "auto") {
    manualPumpControl = false;
    automaticPumpControl();
  } else if (cmd == "status") {
    publishStatus();
    return; // status already published, no need to re-publish below
  } else {
    Serial.println("[MQTT] Unknown command, ignoring.");
    return;
  }

  publishTelemetry(); // reflect the new state immediately
}

// Non-blocking check for one incoming PUBLISH packet from the broker.
// Call frequently from loop(). Also sends PINGREQ on the keepalive interval.
void mqttLoop() {
  if (!mqttConnected) return;

  if (!mqttClient.connected()) {
    Serial.println("[MQTT] Connection dropped.");
    mqttConnected = false;
    return;
  }

  if (millis() - lastPingSent > MQTT_KEEPALIVE_MS) {
    mqttClient.write((uint8_t)0xC0); // PINGREQ
    mqttClient.write((uint8_t)0x00);
    lastPingSent = millis();
  }

  if (mqttClient.available() > 0) {
    uint8_t header = mqttClient.read();
    uint8_t packetType = header & 0xF0;
    int remLen = readMqttRemainingLength(mqttClient);
    if (remLen < 0) return; // timed out reading length, drop this cycle

    if (packetType == 0x30) { // PUBLISH
      uint8_t lenBytes[2];
      mqttClient.readBytes(lenBytes, 2);
      int topicLen = (lenBytes[0] << 8) | lenBytes[1];

      char topicBuf[64];
      int toRead = min(topicLen, 63);
      mqttClient.readBytes(topicBuf, toRead);
      topicBuf[toRead] = '\0';
      // discard any extra topic bytes beyond our buffer
      for (int i = toRead; i < topicLen; i++) mqttClient.read();

      int payloadLen = remLen - 2 - topicLen;
      String payload = "";
      for (int i = 0; i < payloadLen; i++) {
        if (mqttClient.available() || mqttClient.connected()) {
          unsigned long waitStart = millis();
          while (!mqttClient.available() && millis() - waitStart < 500) delay(1);
          if (mqttClient.available()) payload += (char)mqttClient.read();
        }
      }

      if (String(topicBuf) == MQTT_COMMAND_TOPIC) {
        handleCommand(payload);
      }
    } else if (packetType == 0xD0) {
      // PINGRESP — nothing to do, just drained the header+length already
    } else {
      // Unhandled packet type (e.g. another SUBACK) — drain remaining bytes
      for (int i = 0; i < remLen; i++) {
        unsigned long waitStart = millis();
        while (!mqttClient.available() && millis() - waitStart < 200) delay(1);
        if (mqttClient.available()) mqttClient.read();
      }
    }
  }
}

// ==================== TFT DRAWING FUNCTIONS (unchanged) ====================
void drawCard(int x, int y, int w, int h) {
  tft.fillRoundRect(x, y, w, h, 10, CARD_BORDER);
  tft.fillRoundRect(x + 2, y + 2, w - 4, h - 4, 8, CARD_COLOR);
}

void drawHeader() {
  tft.fillRect(0, 0, 320, 42, HEADER_GREEN);
  tft.setTextColor(WHITE);
  tft.setTextSize(2);
  tft.setCursor(75, 7);
  tft.print("SMART FERTILIZER");
  tft.setTextSize(1);
  tft.setCursor(119, 29);
  tft.print("SYSTEM");
}

void drawFooter() {
  tft.fillRect(0, 228, 320, 12, HEADER_GREEN);
  tft.setTextColor(WHITE);
  tft.setTextSize(1);
  tft.setCursor(72, 231);
  tft.print("SEABI TECH INNOVATIONS");
}

void drawPage1() {
  tft.fillScreen(BG_COLOR);
  drawHeader();

  drawCard(8, 50, 148, 108);
  tft.setTextSize(1);
  tft.setTextColor(GREY_TEXT);
